aws_region         = "us-east-1"
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
availability_zone  = "us-east-1a"
instance_type      = "t3.medium"
root_volume_size   = 30

# Récupérer votre IP publique : curl -4 ifconfig.me
admin_cidr = "YOUR_PUBLIC_IP/32"

# Optionnel : personnaliser l emplacement de la clé générée (par défaut ~/.ssh/devops-prod-key)
# ssh_private_key_path = "~/.ssh/devops-prod-key"
